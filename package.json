{
  "name": "clozemaster",
  "version": "0.1.0",
  "description": "Play Clozemaster in your terminal",
  "license": "MIT",
  "type": "module",
  "bin": {
    "clozemaster": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "build:binary": "npx -y bun@1.4.2 scripts/build-binary.ts",
    "install:local": "npm run build:binary && mkdir -p ~/.local/bin && cp bin/clozemaster-$(node -p \"process.platform + '-' + process.arch\") ~/.local/bin/clozemaster.tmp && mv ~/.local/bin/clozemaster.tmp ~/.local/bin/clozemaster",
    "dev": "tsx src/cli.tsx",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release": "sh scripts/release.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ink": "^6.0.0",
    "ink-text-input": "^6.0.0",
    "open": "^10.1.0",
    "react": "^19.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
